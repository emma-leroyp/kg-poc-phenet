<https://w3id.org/phenet-poc/id/synthetic/variable/YIELD_KGHA> a ppeo:observed_variable ;
  rdfs:label "Yield_kgha" ;
  phenet:traitDescription "Grain yield (synthetic, illustrative)." ;
  phenet:unitLabel "kg/ha" ;
  skos:exactMatch obo:TO_0000396 .

<https://w3id.org/phenet-poc/id/synthetic/variable/PLANT_HEIGHT_CM> a ppeo:observed_variable ;
  rdfs:label "PlantHeight_cm" ;
  phenet:traitDescription "Plant height, ground to spike tip (synthetic, illustrative)." ;
  phenet:unitLabel "cm" ;
  skos:exactMatch obo:TO_0000207 ;
  phenet:correspondsToDescriptor "CEREALS_PLANT_HEIGHT" .

<https://w3id.org/phenet-poc/id/synthetic/variable/AWN_CLASS> a ppeo:observed_variable ;
  rdfs:label "AwnClass" ;
  phenet:traitDescription "Awn presence/length class, scored in-field (synthetic, illustrative)." ;
  phenet:unitLabel "category" ;
  skos:exactMatch obo:PO_0025349 ;
  skos:exactMatch obo:TO_0002734 ;
  phenet:correspondsToDescriptor "CEREALS_WHEAT_AWNEDNESS_SCALE" .

<https://w3id.org/phenet-poc/id/synthetic/variable/GRAIN_COLOUR_CLASS> a ppeo:observed_variable ;
  rdfs:label "GrainColourClass" ;
  phenet:traitDescription "Grain colour class, scored in-field (synthetic, illustrative)." ;
  phenet:unitLabel "category" ;
  skos:exactMatch obo:TO_0000385 ;
  phenet:correspondsToDescriptor "CEREALS_GRAIN_COLOUR_SCALE" .

<https://w3id.org/phenet-poc/id/synthetic/variable/STRIPE_RUST_SEV_PCT> a ppeo:observed_variable ;
  rdfs:label "StripeRustSeverity_pct" ;
  phenet:traitDescription "Stripe rust severity (synthetic, illustrative)." ;
  phenet:unitLabel "%" ;
  skos:exactMatch obo:TO_0020055 .

<https://w3id.org/phenet-poc/id/synthetic/variable/SEPTORIA_SEV_PCT> a ppeo:observed_variable ;
  rdfs:label "SeptoriaSeverity_pct" ;
  phenet:traitDescription "Septoria tritici blotch severity (synthetic, illustrative)." ;
  phenet:unitLabel "%" ;
  skos:exactMatch obo:TO_0020065 .

